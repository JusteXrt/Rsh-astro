---
const programs = [
  { name: 'Le 101', city: 'Lyon 8e', type: 'BRS', detail: 'Du T2 au T3', tone: 'teal' },
  { name: 'ACTE II', city: 'Saint-Fons', type: 'Accession', detail: 'Du T2 au T5', tone: 'orange' },
  { name: 'L’Archipel', city: 'Villefranche-sur-Saône', type: 'PSLA', detail: 'En commercialisation', tone: 'sand' }
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Landing page premium de Rhône Saône Habitat, coopérative de promotion immobilière et de syndic."
    />
    <meta name="theme-color" content="#153f43" />
    <title>Rhône Saône Habitat — Habiter mieux, durablement</title>
  </head>

  <body>
    <div class="topbar">
      <div class="shell topbar__inner">
        <span>Coopérative de promotion immobilière · Métropole lyonnaise</span>
        <div>
          <a href="#programmes">Programmes neufs</a>
          <a href="#syndic">Copropriété</a>
          <a href="#contact">Contact</a>
        </div>
      </div>
    </div>

    <header class="header">
      <div class="shell nav">
        <a class="brand" href="#top" aria-label="Accueil Rhône Saône Habitat">
          <img src="/rsh-logo.png" alt="Rhône Saône Habitat" width="242" height="239" />
        </a>
        <nav aria-label="Navigation principale">
          <a href="#acheter">Acheter</a>
          <a href="#programmes">Programmes</a>
          <a href="#syndic">Syndic</a>
          <a href="#cooperative">La coopérative</a>
          <a href="#preuves">Preuves</a>
        </nav>
        <div class="nav__actions">
          <a class="button button--ghost" href="#contact">Parler à un conseiller</a>
          <a class="button" href="#programmes">Voir les programmes</a>
        </div>
        <button class="menu" type="button" aria-label="Ouvrir le menu">Menu</button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="shell hero__grid">
          <div class="hero__copy reveal">
            <span class="eyebrow">Habiter mieux, durablement</span>
            <h1>Acheter accessible.<br /><em>Habiter choisi.</em><br />Construire autrement.</h1>
            <p>
              Rhône Saône Habitat conçoit des programmes immobiliers accessibles et bien situés pour
              devenir propriétaire autour de Lyon, sans renoncer à la qualité, au cadre de vie et au collectif.
            </p>
            <div class="hero__actions">
              <a class="button" href="#recherche">Trouver un programme <span>→</span></a>
              <a class="button button--ghost" href="#cooperative">Découvrir la coopérative</a>
            </div>
            <div class="proofs">
              <div>
                <strong>Promoteur coopératif</strong>
                <span>Programmes neufs et accession</span>
              </div>
              <div>
                <strong>Territoires choisis</strong>
                <span>Lyon et villes de vie</span>
              </div>
              <div>
                <strong>Cadre sécurisé</strong>
                <span>Du projet à la copropriété</span>
              </div>
            </div>
          </div>

          <div class="hero__visual reveal" aria-hidden="true">
            <div class="sun"></div>
            <div class="building"><span></span><span></span><span></span><span></span><i></i></div>
            <div class="hill hill--one"></div>
            <div class="hill hill--two"></div>
            <div class="badge">Accession abordable</div>
            <div class="program-note">
              <small>Nouveau programme</small>
              <strong>ACTE II — Saint-Fons</strong>
              <span>Du T2 au T5 · Livraison 2028</span>
            </div>
          </div>
        </div>
      </section>

      <section id="recherche" class="search">
        <div class="shell">
          <form class="searchbox">
            <div class="tabs" role="tablist" aria-label="Type de projet">
              <button type="button" class="active">Acheter</button>
              <button type="button">Programme neuf</button>
            </div>
            <div class="fields">
              <label>
                <span>Où souhaitez-vous habiter ?</span>
                <input placeholder="Ville, quartier ou bassin de vie" />
              </label>
              <label>
                <span>Dispositif</span>
                <select>
                  <option>BRS / PSLA / libre</option>
                  <option>Accession maîtrisée</option>
                  <option>Accession libre</option>
                </select>
              </label>
              <label>
                <span>Typologie</span>
                <select>
                  <option>2 pièces et +</option>
                  <option>3 pièces et +</option>
                  <option>4 pièces et +</option>
                </select>
              </label>
              <label>
                <span>Budget maîtrisé</span>
                <input placeholder="250 000 €" />
              </label>
              <button class="searchbtn" type="submit">Voir les programmes</button>
            </div>
          </form>
        </div>
      </section>

      <section class="section" id="acheter">
        <div class="shell">
          <div class="heading reveal">
            <div>
              <span class="eyebrow">Promotion, accession, copropriété</span>
              <h2>Construire des logements accessibles sans baisser le niveau d’exigence.</h2>
            </div>
            <p>
              Un logement abordable ne doit pas ressembler à un choix par défaut. Il doit donner envie
              d’habiter, de rester et de faire communauté.
            </p>
          </div>

          <div class="services">
            <article class="service service--dark reveal">
              <small>01 — Accession</small>
              <div class="service__symbol house"></div>
              <h3>Devenir propriétaire</h3>
              <p>BRS, PSLA, TVA réduite : des parcours sécurisés pour acheter avec plus de clarté et moins de pression.</p>
              <a href="#programmes">Voir les programmes <span>→</span></a>
            </article>

            <article class="service service--teal reveal" id="promotion">
              <small>02 — Promotion</small>
              <div class="service__symbol district"></div>
              <h3>Créer des lieux de vie</h3>
              <p>Architecture, usages, espaces partagés : des résidences conçues comme des communautés choisies.</p>
              <a href="#cooperative">Notre démarche <span>→</span></a>
            </article>

            <article class="service service--orange reveal" id="syndic">
              <small>03 — Syndic</small>
              <div class="service__symbol blocks"></div>
              <h3>Faire vivre la copropriété</h3>
              <p>Une gestion de proximité, lisible et responsable pour préserver la qualité du cadre de vie dans le temps.</p>
              <a href="#">Découvrir le syndic <span>→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section class="section section--soft" id="programmes">
        <div class="shell">
          <div class="heading reveal">
            <div>
              <span class="eyebrow">Nos programmes</span>
              <h2>Des lieux de vie posés, désirables et connectés aux usages.</h2>
            </div>
            <a class="button button--ghost" href="#">Voir tous les programmes</a>
          </div>

          <div class="programs">
            {
              programs.map((program, index) => (
                <article class={`program program--${program.tone} reveal`}>
                  <div class="program__sky"></div>
                  <div class={`program__shape shape--${index}`}></div>
                  <div class="program__content">
                    <div>
                      <span>{program.type}</span>
                      <span>{program.detail}</span>
                    </div>
                    <h3>{program.name}</h3>
                    <p>{program.city}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="cooperative">
        <div class="shell coop">
          <div class="coop__visual reveal">
            <div class="coop__sun"></div>
            <div class="coop__building"><span></span><span></span></div>
            <blockquote>« Un programme réussi doit améliorer un quotidien, pas seulement remplir un plan de vente. »</blockquote>
          </div>
          <div class="coop__copy reveal">
            <span class="eyebrow">Rhône Saône Habitat</span>
            <h2>Coopérer en local, utilement, au quotidien.</h2>
            <p>
              Rhône Saône Habitat n’agit pas comme un promoteur privé classique. La coopérative arbitre
              ses projets avec une utilité concrète : prix maîtrisés, accompagnement, qualité d’usage et
              ancrage dans des villes où l’on choisit vraiment d’habiter.
            </p>
            <div class="values">
              <div>
                <strong>Prix maîtrisés</strong>
                <span>Des dispositifs qui ouvrent l’accession sans tirer l’image du logement vers le bas.</span>
              </div>
              <div>
                <strong>Qualité d’usage</strong>
                <span>Des résidences dessinées pour le quotidien : lumière, rangements, mobilités, communs.</span>
              </div>
              <div>
                <strong>Intérêt collectif</strong>
                <span>Une logique coopérative qui privilégie l’équilibre du projet plutôt que la seule marge.</span>
              </div>
              <div>
                <strong>Territoire choisi</strong>
                <span>Habiter autour de Lyon comme un choix de vie, pas comme une concession.</span>
              </div>
            </div>
            <a class="button" href="#">Comprendre notre modèle</a>
          </div>
        </div>
      </section>

      <section class="stats">
        <div class="shell stats__grid">
          <h2>Un acteur engagé,<br />pas un promoteur comme les autres.</h2>
          <div>
            <strong>1</strong>
            <span>coopérative promotrice locale</span>
          </div>
          <div>
            <strong>45+</strong>
            <span>collaborateurs engagés</span>
          </div>
          <div>
            <strong>3</strong>
            <span>leviers : accession, promotion, syndic</span>
          </div>
        </div>
      </section>

      <section class="section" id="preuves">
        <div class="shell">
          <div class="heading reveal">
            <div>
              <span class="eyebrow">Preuves sociales</span>
              <h2>Des parcours qui donnent envie d’habiter autrement.</h2>
            </div>
            <a class="button button--ghost" href="#contact">Échanger sur un projet</a>
          </div>
          <div class="news">
            <article class="news__main reveal">
              <div class="news__art"><span></span><i></i></div>
              <div class="news__body">
                <small>Cas client · Accession</small>
                <h3>Devenir propriétaire sans quitter son bassin de vie.</h3>
                <p>
                  Un accompagnement clair, un budget sécurisé et un programme neuf qui permet de choisir
                  son cadre de vie au lieu de s’éloigner par défaut.
                </p>
              </div>
            </article>
            <article class="news__side reveal">
              <small>Territoire</small>
              <h3>Habiter hors de Lyon, tout en restant connecté à ses usages.</h3>
              <a href="#">Voir le parcours →</a>
            </article>
            <article class="news__side reveal">
              <small>Copropriété</small>
              <h3>Une résidence accompagnée pour rester agréable à vivre.</h3>
              <a href="#">Voir le cas →</a>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer id="contact">
      <div class="shell footer__grid">
        <div>
          <img src="/rsh-logo.png" alt="Rhône Saône Habitat" width="242" height="239" />
          <p>Une coopérative promotrice engagée pour un habitat accessible, désirable et durable.</p>
        </div>
        <div>
          <h4>Nos expertises</h4>
          <a href="#acheter">Acheter</a>
          <a href="#programmes">Programmes</a>
          <a href="#syndic">Syndic</a>
        </div>
        <div>
          <h4>Rhône Saône Habitat</h4>
          <a href="#cooperative">La coopérative</a>
          <a href="#preuves">Preuves sociales</a>
          <a href="#contact">Contact</a>
        </div>
        <div>
          <h4>Nous contacter</h4>
          <p>9 rue du Président Édouard Herriot<br />69001 Lyon</p>
          <p>04 72 69 01 69</p>
        </div>
      </div>
      <div class="shell footer__bottom">
        <span>© {new Date().getFullYear()} Rhône Saône Habitat</span>
        <span>Prototype de direction artistique</span>
      </div>
    </footer>

    <script>
      document.querySelectorAll('.reveal').forEach((el) =>
        new IntersectionObserver(
          ([entry], obs) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              obs.disconnect();
            }
          },
          { threshold: 0.12 }
        ).observe(el)
      );

      document.querySelector('.searchbox')?.addEventListener('submit', (event) => {
        event.preventDefault();
        document.querySelector('#programmes')?.scrollIntoView({ behavior: 'smooth' });
      });

      document.querySelectorAll('.tabs button').forEach((button) =>
        button.addEventListener('click', () => {
          document.querySelectorAll('.tabs button').forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
        })
      );
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #153f43;
    --ink2: #0f3033;
    --teal: #6c9f9d;
    --teal-soft: #dbe9e6;
    --orange: #f18624;
    --sand: #f5f1e8;
    --paper: #fbfaf7;
    --text: #202524;
    --muted: #687371;
    --line: #dce2df;
    --radius: 24px;
    --shadow: 0 24px 54px rgba(21, 63, 67, 0.12);
    --max: 1120px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.55;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  select {
    font: inherit;
  }

  .shell {
    width: min(calc(100% - 48px), var(--max));
    margin: auto;
  }

  .topbar {
    background: var(--ink2);
    color: #fff;
    font-size: 0.78rem;
  }

  .topbar__inner {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar__inner div {
    display: flex;
    gap: 22px;
    color: rgba(255, 255, 255, 0.72);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 250, 247, 0.92);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(220, 226, 223, 0.8);
  }

  .nav {
    min-height: 82px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand img {
    display: block;
    width: 70px;
    height: auto;
    object-fit: contain;
  }

  .nav nav {
    display: flex;
    gap: 24px;
    margin-left: auto;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 750;
  }

  .nav nav a:hover {
    color: var(--orange);
  }

  .nav__actions {
    display: flex;
    gap: 10px;
  }

  .menu {
    display: none;
    border: 0;
    background: var(--ink);
    color: #fff;
    padding: 12px 16px;
    border-radius: 999px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #fff;
    padding: 13px 19px;
    border-radius: 999px;
    font-weight: 820;
    transition: 0.25s;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(21, 63, 67, 0.15);
  }

  .button--ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line);
  }

  .eyebrow {
    display: inline-flex;
    color: var(--orange);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 0.99;
    letter-spacing: -0.035em;
  }

  h1 {
    max-width: 690px;
    color: var(--ink);
    font-size: clamp(3rem, 4vw, 4.55rem);
    margin: 20px 0 24px;
  }

  h1 em {
    font-style: normal;
    color: var(--orange);
  }

  h2 {
    color: var(--ink);
    font-size: clamp(2.35rem, 4.2vw, 4.5rem);
    margin: 14px 0;
  }

  h3 {
    font-size: 2rem;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 54px 0 78px;
    background: linear-gradient(180deg, #f7f3eb 0%, var(--paper) 86%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
    gap: clamp(34px, 4.5vw, 54px);
    align-items: center;
  }

  .hero__copy {
    max-width: 650px;
  }

  .hero__copy > p {
    max-width: 590px;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .proofs {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
    margin-top: 38px;
  }

  .proofs strong,
  .proofs span {
    display: block;
  }

  .proofs strong {
    color: var(--ink);
    font-size: 1.16rem;
  }

  .proofs span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero__visual {
    position: relative;
    height: clamp(400px, 37vw, 490px);
    overflow: hidden;
    background: var(--ink);
    border-radius: 34px;
    box-shadow: var(--shadow);
  }

  .sun {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: var(--orange);
    right: -30px;
    top: -20px;
  }

  .building {
    position: absolute;
    left: 12%;
    right: 22%;
    bottom: 17%;
    height: 53%;
    background: #fff;
    border-radius: 4px 4px 0 0;
    clip-path: polygon(0 23%, 52% 0, 100% 23%, 100% 100%, 0 100%);
  }

  .building span {
    position: absolute;
    width: 18%;
    height: 25%;
    top: 37%;
    background: var(--teal);
    border-radius: 4px;
  }

  .building span:nth-child(1) {
    left: 12%;
  }

  .building span:nth-child(2) {
    left: 36%;
    background: var(--orange);
  }

  .building span:nth-child(3) {
    left: 60%;
  }

  .building span:nth-child(4) {
    left: 82%;
    width: 9%;
    background: var(--ink);
  }

  .building i {
    position: absolute;
    right: 15%;
    bottom: 0;
    width: 16%;
    height: 38%;
    background: var(--ink);
    border-radius: 4px 4px 0 0;
  }

  .hill {
    position: absolute;
    border-radius: 50% 50% 0 0;
  }

  .hill--one {
    width: 90%;
    height: 37%;
    left: -15%;
    bottom: -8%;
    background: var(--teal);
  }

  .hill--two {
    width: 75%;
    height: 28%;
    right: -20%;
    bottom: -8%;
    background: #4e7b79;
  }

  .badge {
    position: absolute;
    right: 18px;
    top: 22px;
    background: var(--orange);
    padding: 10px 15px;
    border-radius: 999px;
    font-weight: 900;
    transform: rotate(3deg);
  }

  .program-note {
    position: absolute;
    left: 20px;
    bottom: 22px;
    width: 245px;
    padding: 22px;
    background: #fff;
    border-radius: 22px;
    box-shadow: var(--shadow);
  }

  .program-note small,
  .program-note strong,
  .program-note span {
    display: block;
  }

  .program-note small {
    color: var(--orange);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .program-note strong {
    color: var(--ink);
    margin: 10px 0 4px;
  }

  .program-note span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .search {
    position: relative;
    z-index: 3;
    margin-top: -40px;
  }

  .searchbox {
    padding: 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 30px;
    box-shadow: var(--shadow);
  }

  .tabs {
    display: flex;
    gap: 7px;
    margin-bottom: 13px;
  }

  .tabs button {
    border: 0;
    background: transparent;
    padding: 9px 16px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 850;
  }

  .tabs .active {
    background: var(--ink);
    color: #fff;
  }

  .fields {
    display: grid;
    grid-template-columns: 1.3fr 1fr 0.8fr 1fr auto;
    gap: 10px;
  }

  .fields label {
    padding: 10px 14px;
    background: #fcfcfa;
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .fields label span {
    display: block;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fields input,
  .fields select {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-weight: 750;
    outline: 0;
  }

  .searchbtn {
    border: 0;
    background: var(--orange);
    padding: 0 24px;
    border-radius: 16px;
    color: #2c1808;
    font-weight: 900;
  }

  .section {
    padding: 112px 0;
  }

  .section--soft {
    background: var(--sand);
  }

  .heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 48px;
  }

  .heading > div {
    max-width: 800px;
  }

  .heading > p {
    max-width: 430px;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .service {
    position: relative;
    min-height: 450px;
    overflow: hidden;
    padding: 30px;
    border-radius: var(--radius);
  }

  .service small {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.68;
  }

  .service h3 {
    position: relative;
    margin-top: 180px;
    margin-bottom: 16px;
  }

  .service p {
    max-width: 320px;
    opacity: 0.76;
  }

  .service > a {
    position: absolute;
