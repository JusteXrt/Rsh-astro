---
const programs = [
  { name: 'Le 101', city: 'Lyon 8e', type: 'BRS', detail: 'Du T2 au T3', tone: 'teal' },
  { name: 'ACTE II', city: 'Saint-Fons', type: 'Accession', detail: 'Du T2 au T5', tone: 'orange' },
  { name: 'L’Archipel', city: 'Villefranche-sur-Saône', type: 'PSLA', detail: 'En commercialisation', tone: 'sand' }
];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Landing page premium de Rhône Saône Habitat." />
  <meta name="theme-color" content="#153f43" />
  <title>Rhône Saône Habitat — Habiter mieux, durablement</title>
</head>
<body>
  <div class="topbar"><div class="shell topbar__inner"><span>Coopérative de l’habitat · Métropole lyonnaise</span><div><a href="#">Espace locataire</a><a href="#">Espace copropriétaire</a><a href="#contact">Contact</a></div></div></div>
  <header class="header"><div class="shell nav"><a class="brand" href="#top"><img src="/rsh-logo.svg" alt="Rhône Saône Habitat" /></a><nav aria-label="Navigation principale"><a href="#acheter">Acheter</a><a href="#louer">Louer</a><a href="#syndic">Syndic</a><a href="#cooperative">La coopérative</a><a href="#actualites">Actualités</a></nav><div class="nav__actions"><a class="button button--ghost" href="#contact">Mon espace</a><a class="button" href="#recherche">Trouver un logement</a></div><button class="menu" aria-label="Ouvrir le menu">Menu</button></div></header>

  <main id="top">
    <section class="hero"><div class="shell hero__grid"><div class="hero__copy reveal"><span class="eyebrow">Habiter mieux, durablement</span><h1>Votre logement.<br><em>Votre avenir.</em><br>Notre engagement.</h1><p>Rhône Saône Habitat accompagne les habitants de la métropole lyonnaise pour acheter, louer et vivre leur copropriété avec confiance.</p><div class="hero__actions"><a class="button" href="#recherche">Découvrir nos logements <span>→</span></a><a class="button button--ghost" href="#cooperative">Découvrir la coopérative</a></div><div class="proofs"><div><strong>3 métiers</strong><span>Accession, location, syndic</span></div><div><strong>100 % local</strong><span>Ancrage métropolitain</span></div><div><strong>1 équipe</strong><span>À vos côtés</span></div></div></div><div class="hero__visual reveal" aria-hidden="true"><div class="sun"></div><div class="building"><span></span><span></span><span></span><span></span><i></i></div><div class="hill hill--one"></div><div class="hill hill--two"></div><div class="badge">Accession abordable</div><div class="program-note"><small>Nouveau programme</small><strong>ACTE II — Saint-Fons</strong><span>Du T2 au T5 · Livraison 2028</span></div></div></div></section>

    <section id="recherche" class="search"><div class="shell"><form class="searchbox"><div class="tabs"><button type="button" class="active">Acheter</button><button type="button">Louer</button></div><div class="fields"><label><span>Où ?</span><input placeholder="Ville ou code postal" /></label><label><span>Type de bien</span><select><option>Appartement</option><option>Maison</option></select></label><label><span>Pièces</span><select><option>2 pièces et +</option><option>3 pièces et +</option><option>4 pièces et +</option></select></label><label><span>Budget maximum</span><input placeholder="250 000 €" /></label><button class="searchbtn" type="submit">Rechercher</button></div></form></div></section>

    <section class="section" id="acheter"><div class="shell"><div class="heading reveal"><div><span class="eyebrow">Trois métiers, une même exigence</span><h2>Un accompagnement clair à chaque moment de votre parcours.</h2></div><p>Des solutions accessibles, des interlocuteurs identifiés et une connaissance concrète du territoire.</p></div><div class="services"><article class="service service--dark reveal"><small>01 — Accession</small><div class="service__symbol house"></div><h3>Devenir propriétaire</h3><p>BRS, PSLA, TVA réduite : trouvez la solution adaptée à votre projet et à vos ressources.</p><a href="#programmes">Voir les programmes <span>→</span></a></article><article class="service service--teal reveal" id="louer"><small>02 — Location</small><div class="service__symbol key"></div><h3>Trouver une location</h3><p>Consultez les offres disponibles et les informations utiles à votre quotidien de locataire.</p><a href="#">Voir les offres <span>→</span></a></article><article class="service service--orange reveal" id="syndic"><small>03 — Syndic</small><div class="service__symbol blocks"></div><h3>Bien vivre sa copropriété</h3><p>Une gestion de proximité, responsable et transparente pour préserver votre cadre de vie.</p><a href="#">Découvrir le syndic <span>→</span></a></article></div></div></section>

    <section class="section section--soft" id="programmes"><div class="shell"><div class="heading reveal"><div><span class="eyebrow">Nos programmes</span><h2>Des lieux de vie pensés pour aujourd’hui et pour demain.</h2></div><a class="button button--ghost" href="#">Voir tous les programmes</a></div><div class="programs">{programs.map((program, index) => <article class={`program program--${program.tone} reveal`}><div class="program__sky"></div><div class="program__shape shape--{index}"></div><div class="program__content"><div><span>{program.type}</span><span>{program.detail}</span></div><h3>{program.name}</h3><p>{program.city}</p></div></article>)}</div></div></section>

    <section class="section" id="cooperative"><div class="shell coop"><div class="coop__visual reveal"><div class="coop__sun"></div><div class="coop__building"><span></span><span></span></div><blockquote>« Mettre l’habitat au service des personnes et du territoire. »</blockquote></div><div class="coop__copy reveal"><span class="eyebrow">Rhône Saône Habitat</span><h2>Une coopérative locale, utile et engagée.</h2><p>Plus qu’un acteur immobilier, nous construisons des parcours résidentiels durables et accessibles, en proximité avec celles et ceux qui habitent le territoire.</p><div class="values"><div><strong>Proximité</strong><span>Des équipes disponibles et ancrées localement.</span></div><div><strong>Accessibilité</strong><span>Des solutions pensées pour des budgets réels.</span></div><div><strong>Durabilité</strong><span>Des opérations responsables et pérennes.</span></div><div><strong>Coopération</strong><span>Une gouvernance tournée vers l’intérêt collectif.</span></div></div><a class="button" href="#">Comprendre notre modèle</a></div></div></section>

    <section class="stats"><div class="shell stats__grid"><h2>Un acteur proche,<br>des impacts concrets.</h2><div><strong>3</strong><span>métiers complémentaires</span></div><div><strong>45+</strong><span>collaborateurs engagés</span></div><div><strong>1</strong><span>territoire au cœur de l’action</span></div></div></section>

    <section class="section" id="actualites"><div class="shell"><div class="heading reveal"><div><span class="eyebrow">Actualités</span><h2>À la une chez Rhône Saône Habitat.</h2></div><a class="button button--ghost" href="#">Toutes les actualités</a></div><div class="news"><article class="news__main reveal"><div class="news__art"><span></span><i></i></div><div class="news__body"><small>Vie de la coopérative</small><h3>Des projets immobiliers conçus au plus près des usages.</h3><p>Découvrez comment nos équipes imaginent des logements accessibles, sobres et agréables à vivre.</p></div></article><article class="news__side reveal"><small>Accession</small><h3>Le BRS, une autre façon de devenir propriétaire.</h3><a href="#">Lire l’article →</a></article><article class="news__side reveal"><small>Pratique</small><h3>Les bons réflexes pour préparer votre projet logement.</h3><a href="#">Lire l’article →</a></article></div></div></section>

    <section class="section practical" id="contact"><div class="shell practical__grid"><div class="practical__intro reveal"><span class="eyebrow">Accès rapides</span><h2>Vous êtes déjà client ?</h2><p>Retrouvez directement les services et informations qui vous concernent.</p></div><div class="quicklinks reveal"><a href="#">Je suis locataire <span>→</span></a><a href="#">Je suis copropriétaire <span>→</span></a><a href="#">Je souhaite vendre un terrain <span>→</span></a><a href="#">Trouver un contact <span>→</span></a></div></div></section>
  </main>

  <footer><div class="shell footer__grid"><div><img src="/rsh-logo.svg" alt="Rhône Saône Habitat" /><p>Une coopérative locale engagée pour un habitat accessible, durable et de qualité.</p></div><div><h4>Nos métiers</h4><a href="#acheter">Acheter</a><a href="#louer">Louer</a><a href="#syndic">Syndic</a></div><div><h4>Rhône Saône Habitat</h4><a href="#cooperative">La coopérative</a><a href="#actualites">Actualités</a><a href="#contact">Contact</a></div><div><h4>Nous contacter</h4><p>9 rue du Président Édouard Herriot<br />69001 Lyon</p><p>04 72 69 01 69</p></div></div><div class="shell footer__bottom"><span>© {new Date().getFullYear()} Rhône Saône Habitat</span><span>Prototype de direction artistique</span></div></footer>

  <script>
    document.querySelectorAll('.reveal').forEach((el) => new IntersectionObserver(([entry], obs) => { if (entry.isIntersecting) { entry.target.classList.add('visible'); obs.disconnect(); } }, { threshold: .12 }).observe(el));
    document.querySelector('.searchbox')?.addEventListener('submit', (event) => { event.preventDefault(); document.querySelector('#programmes')?.scrollIntoView({ behavior: 'smooth' }); });
    document.querySelectorAll('.tabs button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.tabs button').forEach((item) => item.classList.remove('active')); button.classList.add('active'); }));
  </script>
</body>
</html>

<style is:global>
:root{--ink:#153f43;--ink2:#0f3033;--teal:#6c9f9d;--teal-soft:#dbe9e6;--orange:#f18624;--sand:#f5f1e8;--paper:#fbfaf7;--text:#202524;--muted:#687371;--line:#dce2df;--radius:28px;--shadow:0 28px 70px rgba(21,63,67,.14);--max:1220px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.55}a{color:inherit;text-decoration:none}button,input,select{font:inherit}.shell{width:min(calc(100% - 40px),var(--max));margin:auto}.topbar{background:var(--ink2);color:#fff;font-size:.78rem}.topbar__inner{min-height:38px;display:flex;align-items:center;justify-content:space-between}.topbar__inner div{display:flex;gap:22px;color:rgba(255,255,255,.72)}.header{position:sticky;top:0;z-index:20;background:rgba(251,250,247,.92);backdrop-filter:blur(18px);border-bottom:1px solid rgba(220,226,223,.8)}.nav{min-height:86px;display:flex;align-items:center;gap:34px}.brand img{display:block;width:74px;height:74px}.nav nav{display:flex;gap:27px;margin-left:auto;font-size:.92rem;font-weight:750;color:var(--ink)}.nav nav a:hover{color:var(--orange)}.nav__actions{display:flex;gap:10px}.menu{display:none;border:0;background:var(--ink);color:white;padding:12px 16px;border-radius:999px}.button{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:1px solid var(--ink);background:var(--ink);color:#fff;padding:14px 20px;border-radius:999px;font-weight:820;transition:.25s}.button:hover{transform:translateY(-2px);box-shadow:0 12px 25px rgba(21,63,67,.15)}.button--ghost{background:transparent;color:var(--ink);border-color:var(--line)}.eyebrow{display:inline-flex;color:var(--orange);font-size:.72rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}h1,h2,h3{font-family:"Arial Narrow",Inter,ui-sans-serif,sans-serif;line-height:.96;letter-spacing:-.045em}h1{font-size:clamp(3.8rem,7vw,7.4rem);margin:22px 0 26px;color:var(--ink)}h1 em{font-style:normal;color:var(--orange)}h2{font-size:clamp(2.6rem,4.8vw,5rem);margin:14px 0;color:var(--ink)}h3{font-size:2rem}.hero{position:relative;overflow:hidden;padding:66px 0 96px;background:linear-gradient(180deg,#f7f3eb 0%,var(--paper) 86%)}.hero__grid{display:grid;grid-template-columns:1.04fr .96fr;gap:60px;align-items:center}.hero__copy>p{max-width:650px;color:var(--muted);font-size:1.16rem}.hero__actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.proofs{display:flex;gap:32px;flex-wrap:wrap;margin-top:48px}.proofs strong,.proofs span{display:block}.proofs strong{color:var(--ink);font-size:1.25rem}.proofs span{font-size:.82rem;color:var(--muted)}.hero__visual{height:625px;position:relative;border-radius:42px;overflow:hidden;background:var(--ink);box-shadow:var(--shadow)}.sun{position:absolute;width:300px;height:300px;border-radius:50%;background:var(--orange);right:-30px;top:-20px}.building{position:absolute;left:12%;right:22%;bottom:17%;height:53%;background:#fff;border-radius:4px 4px 0 0;clip-path:polygon(0 23%,52% 0,100% 23%,100% 100%,0 100%)}.building span{position:absolute;width:18%;height:25%;top:37%;background:var(--teal);border-radius:4px}.building span:nth-child(1){left:12%}.building span:nth-child(2){left:36%;background:var(--orange)}.building span:nth-child(3){left:60%}.building span:nth-child(4){left:82%;width:9%;background:var(--ink)}.building i{position:absolute;right:15%;bottom:0;width:16%;height:38%;background:var(--ink);border-radius:4px 4px 0 0}.hill{position:absolute;border-radius:50% 50% 0 0}.hill--one{width:90%;height:37%;left:-15%;bottom:-8%;background:var(--teal)}.hill--two{width:75%;height:28%;right:-20%;bottom:-8%;background:#4e7b79}.badge{position:absolute;right:18px;top:22px;background:var(--orange);padding:10px 15px;border-radius:999px;font-weight:900;transform:rotate(3deg)}.program-note{position:absolute;left:20px;bottom:22px;width:245px;padding:22px;border-radius:22px;background:#fff;box-shadow:var(--shadow)}.program-note small,.program-note strong,.program-note span{display:block}.program-note small{color:var(--orange);font-weight:900;text-transform:uppercase;font-size:.68rem}.program-note strong{color:var(--ink);margin:10px 0 4px}.program-note span{color:var(--muted);font-size:.8rem}.search{position:relative;z-index:3;margin-top:-44px}.searchbox{padding:18px;background:#fff;border:1px solid var(--line);border-radius:30px;box-shadow:var(--shadow)}.tabs{display:flex;gap:7px;margin-bottom:13px}.tabs button{border:0;background:transparent;padding:9px 16px;border-radius:999px;font-weight:850;color:var(--muted)}.tabs .active{background:var(--ink);color:#fff}.fields{display:grid;grid-template-columns:1.3fr 1fr .8fr 1fr auto;gap:10px}.fields label{padding:10px 14px;background:#fcfcfa;border:1px solid var(--line);border-radius:16px}.fields label span{display:block;font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:var(--muted)}.fields input,.fields select{border:0;background:transparent;width:100%;outline:0;color:var(--ink);font-weight:750}.searchbtn{border:0;background:var(--orange);padding:0 24px;border-radius:16px;font-weight:900;color:#2c1808}.section{padding:112px 0}.section--soft{background:var(--sand)}.heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:48px}.heading>div{max-width:800px}.heading>p{max-width:430px;color:var(--muted);font-size:1.05rem}.services{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.service{position:relative;min-height:450px;padding:30px;border-radius:var(--radius);overflow:hidden}.service small{font-size:.72rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase;opacity:.68}.service h3{position:relative;margin-top:180px;margin-bottom:16px}.service p{max-width:320px;opacity:.76}.service>a{position:absolute;left:30px;right:30px;bottom:28px;display:flex;justify-content:space-between;font-weight:900}.service>a span{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.5)}.service--dark{background:var(--ink);color:#fff}.service--teal{background:var(--teal-soft);color:var(--ink)}.service--orange{background:var(--orange);color:#2d1908}.service__symbol{position:absolute;right:30px;top:42px;width:140px;height:140px}.house{background:var(--orange);clip-path:polygon(50% 0,100% 40%,100% 100%,0 100%,0 40%)}.key{border:28px solid #fff;border-radius:50%}.key:after{content:"";position:absolute;width:100px;height:28px;background:#fff;right:80px;top:28px}.blocks{background:linear-gradient(90deg,#fff 0 45%,transparent 45% 55%,#fff 55%)}.programs{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:18px}.program{position:relative;min-height:510px;border-radius:var(--radius);overflow:hidden;color:#fff;background:var(--ink)}.program__sky{position:absolute;inset:0;background:linear-gradient(135deg,var(--teal),#dbe9e6)}.program--orange .program__sky{background:linear-gradient(135deg,#f3b56f,var(--orange))}.program--sand .program__sky{background:linear-gradient(135deg,#e7ece7,#f2d7aa)}.program__shape{position:absolute;left:12%;right:12%;bottom:0;height:70%;background:#fff;clip-path:polygon(15% 15%,60% 0,100% 17%,100% 100%,0 100%,0 28%)}.program__shape:after{content:"";position:absolute;left:18%;top:35%;width:18%;height:25%;background:var(--orange);box-shadow:95px 0 0 var(--teal),190px 0 0 var(--ink)}.program__content{position:absolute;inset:auto 24px 24px;padding-top:100px;background:linear-gradient(transparent,rgba(10,40,42,.92))}.program__content div{display:flex;gap:7px}.program__content div span{padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.16);font-size:.7rem;font-weight:850}.program__content h3{margin:14px 0 5px}.program__content p{margin:0;color:rgba(255,255,255,.72)}.coop{display:grid;grid-template-columns:.9fr 1.1fr;gap:74px;align-items:center}.coop__visual{height:590px;position:relative;overflow:hidden;border-radius:36px;background:var(--teal-soft)}.coop__sun{position:absolute;width:230px;height:230px;border-radius:50%;background:var(--orange);right:25px;top:25px}.coop__building{position:absolute;left:16%;right:20%;bottom:0;height:70%;background:#fff}.coop__building span{position:absolute;left:15%;top:20%;width:20%;height:55%;background:var(--ink)}.coop__building span:nth-child(2){left:50%;background:var(--teal)}.coop blockquote{position:absolute;left:24px;right:24px;bottom:24px;margin:0;padding:24px;background:#fff;border-radius:20px;color:var(--ink);font-weight:800}.coop__copy>p{font-size:1.08rem;color:var(--muted)}.values{display:grid;grid-template-columns:1fr 1fr;gap:4px 18px;margin:32px 0}.values div{padding:18px 0;border-top:1px solid var(--line)}.values strong,.values span{display:block}.values strong{color:var(--ink)}.values span{font-size:.84rem;color:var(--muted)}.stats{padding:86px 0;background:var(--ink);color:#fff}.stats__grid{display:grid;grid-template-columns:1.3fr repeat(3,1fr);gap:35px;align-items:end}.stats h2{color:#fff;margin:0;font-size:clamp(2.5rem,4vw,4.7rem)}.stats__grid>div{border-left:1px solid rgba(255,255,255,.18);padding-left:22px}.stats strong,.stats span{display:block}.stats strong{font-size:clamp(3rem,5vw,5.7rem);line-height:1;color:var(--orange);letter-spacing:-.07em}.stats span{color:rgba(255,255,255,.65);font-size:.85rem}.news{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:18px}.news__main,.news__side{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.news__art{height:300px;position:relative;background:var(--teal-soft)}.news__art span{position:absolute;width:220px;height:220px;border-radius:50%;background:var(--orange);right:7%;top:12%}.news__art i{position:absolute;left:10%;right:30%;bottom:0;height:70%;background:var(--ink);clip-path:polygon(20% 20%,65% 0,100% 25%,100% 100%,0 100%,0 35%)}.news__body,.news__side{padding:25px}.news small{color:var(--orange);font-weight:900;text-transform:uppercase;letter-spacing:.08em}.news__body h3{margin:14px 0}.news__body p{color:var(--muted)}.news__side{min-height:300px;display:flex;flex-direction:column}.news__side h3{margin-top:35px}.news__side a{margin-top:auto;font-weight:900;color:var(--ink)}.practical{background:var(--orange)}.practical__grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}.practical__intro h2{color:#2c1808}.practical__intro p{color:rgba(44,24,8,.72)}.quicklinks{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quicklinks a{display:flex;justify-content:space-between;align-items:center;padding:22px;background:#fff;border-radius:18px;font-weight:900;color:var(--ink)}footer{padding:75px 0 28px;background:var(--ink2);color:#fff}.footer__grid{display:grid;grid-template-columns:1.2fr .7fr .8fr .9fr;gap:42px}.footer__grid>div{display:flex;flex-direction:column;align-items:flex-start}.footer__grid img{width:92px;background:#fff;border-radius:50%;padding:4px}.footer h4{color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.1em;font-size:.7rem}.footer a,.footer p{margin:4px 0;color:rgba(255,255,255,.72);font-size:.88rem}.footer__bottom{display:flex;justify-content:space-between;margin-top:50px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);font-size:.78rem;color:rgba(255,255,255,.42)}.reveal{opacity:0;transform:translateY(20px);transition:.7s ease}.reveal.visible{opacity:1;transform:none}@media(max-width:980px){.nav nav,.nav__actions{display:none}.menu{display:block;margin-left:auto}.hero__grid,.coop,.practical__grid{grid-template-columns:1fr}.hero__visual{height:540px}.fields{grid-template-columns:1fr 1fr}.searchbtn{min-height:58px}.services,.programs,.news{grid-template-columns:1fr 1fr}.services article:last-child,.programs article:first-child,.news article:first-child{grid-column:1/-1}.stats__grid{grid-template-columns:1fr 1fr}.stats h2{grid-column:1/-1}.footer__grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.shell{width:min(calc(100% - 24px),var(--max))}.topbar{display:none}.nav{min-height:72px}.brand img{width:56px;height:56px}.hero{padding-top:38px}.hero__grid{gap:30px}h1{font-size:3.35rem}.hero__visual{height:430px;border-radius:28px}.program-note{width:210px}.search{margin-top:-20px}.fields,.services,.programs,.news,.values,.stats__grid,.quicklinks,.footer__grid{grid-template-columns:1fr}.services article:last-child,.programs article:first-child,.news article:first-child,.stats h2{grid-column:auto}.section{padding:78px 0}.heading{display:block}.heading>p{margin-top:18px}.service{min-height:420px}.program{min-height:430px}.coop__visual{height:460px}.stats__grid>div{border-left:0;border-top:1px solid rgba(255,255,255,.18);padding:18px 0}.footer__bottom{display:block}.footer__bottom span{display:block;margin-top:7px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>
